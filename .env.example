# Copy to .env.local for local dev and to Vercel -> Project -> Settings -> Environment Variables.
# The production URL (e.g. https://shivam-kr.vercel.app or your custom domain).
# Used for canonicals, og:image, sitemap, and JSON-LD. REQUIRED for correct SEO.
NEXT_PUBLIC_SITE_URL=https://shivam-kr.vercel.app

# Google Search Console site verification token.
# After creating a property in Search Console (URL prefix method), add the content value here.
# Find it in GSC -> Settings -> Verification -> HTML tag.
GOOGLE_SITE_VERIFICATION=your-google-verification-token

# --- Telegram visitor tracker (only these two are required) ---
# Get a bot token from @BotFather, then your numeric chat id from @userinfobot.
# Both are private env vars and never reach the client.
# NOTE: no NEXT_PUBLIC_* tracker vars are needed. The tracker is enabled in
# production builds automatically and the endpoint rate-limits per IP.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789